<?xml version="1.0" encoding="utf-8"?>
<!-- The app's mark: a sun rising over the horizon, "look up from the phone".
     The same idea as ui/components/SunMark.kt, with rays so it reads at
     small sizes. Keep it inside the 66 dp safe zone in the middle, because
     launchers crop the icon to a circle or a rounded square. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Rays -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="@color/icon_accent"
        android:strokeWidth="3.6"
        android:strokeLineCap="round"
        android:pathData="M30.98,49.12 L26.75,47.58 M39.95,37.43 L37.37,33.74 M54,33 L54,28.5 M68.05,37.43 L70.63,33.74 M77.02,49.12 L81.25,47.58" />
    <!-- Sun: the part of a circle that is above the horizon -->
    <path
        android:fillColor="@color/icon_accent"
        android:pathData="M36.25,60.5 A18,18 0 1,1 71.75,60.5 Z" />
    <!-- Horizon -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="@color/icon_foreground"
        android:strokeWidth="5.5"
        android:strokeLineCap="round"
        android:pathData="M30,66 L78,66" />
</vector>
