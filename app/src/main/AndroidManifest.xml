<?xml version="1.0" encoding="utf-8"?>
<!-- No INTERNET permission on purpose: nothing can leave the phone. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Alarm vibration on levels 1 and 2. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:name=".DistractionKillerApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.DistractionKiller">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Level 2 break and thank-you screen. Its own task, so closing it
             returns to the video app, and it stays out of the recent apps. -->
        <activity
            android:name=".interrupt.CalmActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:taskAffinity=""
            android:windowSoftInputMode="adjustResize" />

        <!-- Scroll watcher. Only the system can bind to it (BIND_ACCESSIBILITY_SERVICE). -->
        <service
            android:name=".detection.ScrollWatcherService"
            android:exported="true"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>
    </application>

</manifest>
